generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(cuid())
  name                  String
  email                 String                   @unique
  password              String
  role                  Role
  active                Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  emAlmoco              Boolean                  @default(false)
  tipoBalcao            TipoBalcao?
  createdBy             String?
  deletedAt             DateTime?
  failedLoginAttempts   Int                      @default(0)
  lastLoginAt           DateTime?
  lockedUntil           DateTime?
  mustChangePassword    Boolean                  @default(false)
  passwordUpdatedAt     DateTime?
  username              String?                  @unique
  cargo                 String?
  observacoes           String?
  telefone              String?
  configNotificacoes    ConfiguracaoNotificacao?
  eventos               EventoSistema[]
  lembretes             LembreteSistema[]
  importacoes           LogImportacao[]
  mensagensRecebidas    MensagemInterna[]        @relation("Destinatario")
  mensagensEnviadas     MensagemInterna[]        @relation("Remetente")
  notificacoes          Notificacao[]
  ordensServicoBalcao   OrdemServico[]           @relation("Balcao")
  ordensServicoMecanico OrdemServico[]           @relation("Mecanico")

  @@index([role])
  @@index([tipoBalcao])
  @@index([active])
  @@index([username])
  @@index([deletedAt])
}

model Categoria {
  id               String      @id @default(cuid())
  nome             String      @unique
  slug             String      @unique
  createdAt        DateTime    @default(now())
  ativa            Boolean     @default(true)
  descricao        String?
  descricaoIa      String?
  icone            String?
  mostrarNaVitrine Boolean     @default(true)
  ordem            Int         @default(0)
  parentId         String?
  permiteCadastro  Boolean     @default(true)
  parent           Categoria?  @relation("Subcategorias", fields: [parentId], references: [id])
  subcategorias    Categoria[] @relation("Subcategorias")
  pecas            Peca[]
}

model Peca {
  id                    String                   @id @default(cuid())
  nome                  String
  descricao             String?
  codigo                String                   @unique
  precoVenda            Decimal                  @default(0)
  precoCusto            Decimal                  @default(0)
  quantidade            Int                      @default(0)
  estoqueMinimo         Int                      @default(5)
  ativo                 Boolean                  @default(true)
  imagemUrl             String?
  categoriaId           String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  vitrine               Boolean                  @default(false)
  compatibilidade       String?
  marca                 String?
  subcategoria          String?
  tamanho               String?
  genero                String?
  cor                   String?
  descricaoCurta        String?
  destaque              Boolean                  @default(false)
  oferta                Boolean                  @default(false)
  precoOferta           Decimal?
  codigoBarras          String?                  @unique
  dataFimOferta         String?
  dataInicioOferta      String?
  precoVitrine          Decimal?
  quantidadeLoja        Int                      @default(0)
  custoMedio            Decimal                  @default(0)
  localizacao           String?
  avaliacoes            Avaliacao[]
  compatibilidades      CompatibilidadeVeiculo[]
  favoritos             Favorito[]
  garantiasCliente      GarantiaCliente[]
  navegacoes            HistoricoNavegacao[]
  itensOS               ItemOS[]
  movimentacoes         MovimentacaoEstoque[]
  orcamentosItens       OrcamentoItem[]
  categoria             Categoria                @relation(fields: [categoriaId], references: [id])
  documentos            PecaDocumento[]
  imagens               PecaImagem[]
  pedidoItens           PedidoItem[]
  pedidoVitrineItens    PedidoVitrineItem[]
  perguntasProduto      Pergunta[]
  visualizacoes         ProdutoVisualizacao[]
  promocoesProduto      PromocaoProduto[]
  transferenciasEstoque TransferenciaEstoque[]
  vendaItens            VendaItem[]

  @@index([codigo])
  @@index([codigoBarras])
  @@index([quantidade])
  @@index([quantidadeLoja])
}

model OrdemServico {
  id                     String                 @id @default(cuid())
  numero                 Int                    @unique @default(autoincrement())
  nomeCliente            String
  telefoneCliente        String
  modeloMoto             String
  placaMoto              String?
  anoMoto                String?
  descricaoProblema      String?
  diagnostico            String?
  status                 StatusOS               @default(ABERTA)
  valorTotal             Decimal                @default(0)
  valorMaoDeObra         Decimal                @default(0)
  mecanicoId             String?
  balcaoId               String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  tipoServico            String?
  desconto               Decimal                @default(0)
  finalizadoEm           DateTime?
  finalizadoPor          String?
  formaPagamento         String?
  observacoes            String?
  dataPagamento          DateTime?
  statusPagamento        String?
  usuarioPagamento       String?
  valorPago              Decimal?
  dataAgendamento        DateTime?
  fimServico             DateTime?
  garantiaAte            DateTime?
  garantiaDias           Int?
  horaAgendamento        String?
  inicioServico          DateTime?
  kmAtual                String?
  previsaoEntrega        DateTime?
  tempoEstimado          Int?
  assinatura             AssinaturaOS?
  fotos                  FotoOS[]
  historico              HistoricoOS[]
  checklist              ItemChecklistOS[]
  itens                  ItemOS[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  notaFiscal             NotaFiscal?
  balcao                 User?                  @relation("Balcao", fields: [balcaoId], references: [id])
  mecanico               User?                  @relation("Mecanico", fields: [mecanicoId], references: [id])
  revisoes               RevisaoAgendada[]
  servicos               ServicoOrdem[]
  whatsappLogs           WhatsAppLog[]

  @@index([status])
  @@index([balcaoId])
  @@index([mecanicoId])
  @@index([dataAgendamento])
  @@index([previsaoEntrega])
}

model ItemOS {
  id             String       @id @default(cuid())
  ordemServicoId String
  pecaId         String
  quantidade     Int          @default(1)
  precoUnitario  Decimal      @default(0)
  adaptado       Boolean      @default(false)
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  peca           Peca         @relation(fields: [pecaId], references: [id])
}

model ServicoOrdem {
  id             String       @id @default(cuid())
  ordemServicoId String
  nome           String
  valor          Decimal      @default(0)
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
}

model NotaFiscal {
  id             String        @id @default(cuid())
  ordemServicoId String?       @unique
  vendaId        String?       @unique
  numero         String        @unique
  chaveAcesso    String?
  pdfUrl         String?
  dataServico    DateTime?
  emitidaEm      DateTime      @default(now())
  createdAt      DateTime      @default(now())
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  venda          Venda?        @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@index([vendaId])
}

model NotaManual {
  id             String           @id @default(cuid())
  numero         Int              @unique @default(autoincrement())
  cliente        String?
  cpfCnpj        String?
  endereco       String?
  observacoes    String?
  valorTotal     Decimal          @default(0)
  formaPagamento String?
  status         String           @default("EMITIDA")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  itens          NotaManualItem[]
}

model NotaManualItem {
  id            String     @id @default(cuid())
  notaManualId  String
  produto       String
  codigo        String?
  quantidade    Int        @default(1)
  valorUnitario Decimal    @default(0)
  notaManual    NotaManual @relation(fields: [notaManualId], references: [id], onDelete: Cascade)
}

model ServicoTabelado {
  id            String                     @id @default(cuid())
  nome          String
  descricao     String?
  valor         Decimal                    @default(0)
  tempoEstimado Int?
  garantiaDias  Int?
  categoria     String?
  ativo         Boolean                    @default(true)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  templates     ChecklistServicoTemplate[]

  @@index([categoria])
  @@index([ativo])
}

model ChecklistTemplate {
  id        String                     @id @default(cuid())
  nome      String
  ordem     Int                        @default(0)
  ativo     Boolean                    @default(true)
  createdAt DateTime                   @default(now())
  servicos  ChecklistServicoTemplate[]
  itens     ChecklistTemplateItem[]
}

model ChecklistTemplateItem {
  id          String            @id @default(cuid())
  templateId  String
  item        String
  obrigatorio Boolean           @default(true)
  ordem       Int               @default(0)
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model ChecklistServicoTemplate {
  id                String            @id @default(cuid())
  servicoTabeladoId String
  templateId        String
  servicoTabelado   ServicoTabelado   @relation(fields: [servicoTabeladoId], references: [id], onDelete: Cascade)
  template          ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([servicoTabeladoId, templateId])
}

model ItemChecklistOS {
  id             String       @id @default(cuid())
  ordemServicoId String
  item           String
  obrigatorio    Boolean      @default(false)
  concluido      Boolean      @default(false)
  observacao     String?
  usuario        String?
  concluidoEm    DateTime?
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId])
}

model FotoOS {
  id             String       @id @default(cuid())
  ordemServicoId String
  tipo           String
  obrigatorio    Boolean      @default(false)
  url            String
  descricao      String?
  createdAt      DateTime     @default(now())
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId])
  @@index([tipo])
}

model AssinaturaOS {
  id             String       @id @default(cuid())
  ordemServicoId String       @unique
  nome           String
  assinatura     String
  ip             String?
  data           DateTime     @default(now())
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
}

model HistoricoOS {
  id             String       @id @default(cuid())
  ordemServicoId String
  tipo           String
  descricao      String?
  usuario        String?
  usuarioId      String?
  createdAt      DateTime     @default(now())
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId])
  @@index([tipo])
  @@index([createdAt])
}

model RevisaoAgendada {
  id             String       @id @default(cuid())
  ordemServicoId String
  tipo           String
  valor          String
  descricao      String?
  notificada     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId])
}

model WhatsAppLog {
  id             String        @id @default(cuid())
  ordemServicoId String?
  telefone       String
  tipo           String
  mensagem       String
  status         String        @default("PENDENTE")
  resposta       String?
  enviadoEm      DateTime?
  createdAt      DateTime      @default(now())
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id])

  @@index([ordemServicoId])
  @@index([status])
  @@index([tipo])
}

model MovimentacaoEstoque {
  id         String   @id @default(cuid())
  pecaId     String
  tipo       String
  quantidade Int      @default(1)
  origem     String?
  destino    String?
  usuario    String?
  observacao String?
  createdAt  DateTime @default(now())
  peca       Peca     @relation(fields: [pecaId], references: [id])

  @@index([pecaId])
  @@index([tipo])
  @@index([createdAt])
}

model TransferenciaEstoque {
  id         String   @id @default(cuid())
  pecaId     String
  quantidade Int      @default(1)
  de         String
  para       String
  usuario    String?
  createdAt  DateTime @default(now())
  peca       Peca     @relation(fields: [pecaId], references: [id])

  @@index([createdAt])
}

model Cliente {
  id             String               @id @default(cuid())
  nome           String
  telefone       String               @unique
  email          String?
  password       String
  modeloMoto     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  cep            String?
  cidade         String?
  cpf            String?
  dataNascimento DateTime?
  endereco       String?
  estado         String?
  ultimoLogin    DateTime?
  whatsapp       String?
  avaliacoes     Avaliacao[]
  favoritos      Favorito[]
  garantias      GarantiaCliente[]
  navegacao      HistoricoNavegacao[]
  notificacoes   NotificacaoCliente[]
  orcamentos     Orcamento[]
  pedidos        Pedido[]
  pedidosVitrine PedidoVitrine[]
  perguntas      Pergunta[]
  sessoes        SessaoCliente[]
}

model GarantiaCliente {
  id           String   @id @default(cuid())
  clienteId    String
  pedidoId     String
  pecaId       String
  dataCompra   DateTime @default(now())
  diasGarantia Int      @default(90)
  expiraEm     DateTime
  status       String   @default("ATIVA")
  observacao   String?
  createdAt    DateTime @default(now())
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  peca         Peca     @relation(fields: [pecaId], references: [id])
  pedido       Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([pedidoId])
  @@index([status])
}

model NotificacaoCliente {
  id        String   @id @default(cuid())
  clienteId String
  tipo      String
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([lida])
  @@index([createdAt])
}

model SessaoCliente {
  id        String   @id @default(cuid())
  clienteId String
  token     String   @unique
  ip        String?
  userAgent String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([token])
  @@index([ativo])
}

model Orcamento {
  id         String          @id @default(cuid())
  numero     Int             @unique @default(autoincrement())
  clienteId  String
  modeloMoto String?
  observacao String?
  status     String          @default("PENDENTE")
  total      Decimal         @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  cliente    Cliente         @relation(fields: [clienteId], references: [id])
  itens      OrcamentoItem[]
}

model OrcamentoItem {
  id            String    @id @default(cuid())
  orcamentoId   String
  pecaId        String
  quantidade    Int       @default(1)
  precoUnitario Decimal   @default(0)
  orcamento     Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  peca          Peca      @relation(fields: [pecaId], references: [id])
}

model ConfigVitrine {
  id                    String   @id @default(cuid())
  whatsappNumero        String   @default("")
  bannerTexto           String?
  bannerAtivo           Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  bannerCorOverlay      String?
  bannerCtaLink         String?
  bannerCtaTexto        String?
  bannerImagem          String?
  bannerOpacidade       String?
  bannerSubtitulo       String?
  bannerCorTexto        String?
  bannerMobileImagem    String?
  bannerPosicaoConteudo String?

  @@index([bannerAtivo])
}

model BannerCarrossel {
  id              String   @id @default(cuid())
  titulo          String?
  subtitulo       String?
  imagemDesktop   String?
  imagemMobile    String?
  ctaTexto        String?
  ctaLink         String?
  ativo           Boolean  @default(true)
  ordem           Int      @default(0)
  dataInicio      String?
  dataFim         String?
  corTexto        String?
  posicaoConteudo String?
  overlay         String?
  opacidade       String?
  // Rodada Subcategorias (2026-08-21): onde o banner deve ser exibido.
  // DESKTOP | MOBILE | AMBOS — default AMBOS = compatibilidade retroativa
  // (banners existentes continuam aparecendo em desktop e mobile).
  exibirEm        String   @default("AMBOS")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Fornecedor {
  id                String             @id @default(cuid())
  nome              String
  nomeFantasia      String?
  cnpj              String?
  telefone          String?
  whatsapp          String?
  email             String?
  vendedor          String?
  prazoMedioEntrega String?
  formaPagamento    String?
  observacoes       String?
  ativo             Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  pedidos           PedidoFornecedor[]

  @@index([nome])
  @@index([ativo])
}

model PedidoFornecedor {
  id                     String                 @id @default(cuid())
  fornecedorId           String
  numero                 String?
  dataPedido             DateTime               @default(now())
  previsaoEntrega        DateTime?
  status                 String                 @default("RASCUNHO")
  valorTotal             Decimal                @default(0)
  observacoes            String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  itens                  ItemPedidoFornecedor[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  fornecedor             Fornecedor             @relation(fields: [fornecedorId], references: [id])

  @@index([fornecedorId])
  @@index([status])
  @@index([dataPedido])
}

model ItemPedidoFornecedor {
  id            String           @id @default(cuid())
  pedidoId      String
  produto       String
  codigo        String?
  quantidade    Int              @default(1)
  valorUnitario Decimal          @default(0)
  valorTotal    Decimal          @default(0)
  observacoes   String?
  pedido        PedidoFornecedor @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

model RegraClassificacao {
  id           String   @id @default(cuid())
  palavraChave String
  categoria    String
  subcategoria String?
  peso         Int      @default(1)
  createdAt    DateTime @default(now())

  @@unique([palavraChave, categoria])
  @@index([palavraChave])
  @@index([categoria])
}

model CorrecaoClassificacao {
  id                  String   @id @default(cuid())
  pecaNome            String
  categoriaAntiga     String?
  categoriaNova       String
  palavrasEncontradas String?
  criadoPor           String?
  createdAt           DateTime @default(now())

  @@index([pecaNome])
}

model Revisao {
  id        String   @id @default(cuid())
  nome      String   @unique
  valor     Decimal  @default(0)
  ordem     Int      @default(0)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PecaImagem {
  id        String   @id @default(cuid())
  pecaId    String
  url       String
  tipo      String   @default("PRINCIPAL")
  // Rodada Subcategorias (2026-08-21): cor ASSOCIADA a esta foto (ex.: Foto 1 → Preto,
  // Foto 2 → Vermelho, Foto 3 → Azul). Nullable p/ não quebrar imagens antigas.
  // NÃO é o mesmo que Peca.cor (cor principal do produto/capacete).
  cor       String?
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  peca      Peca     @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@index([pecaId])
}

model PecaDocumento {
  id        String   @id @default(cuid())
  pecaId    String
  nome      String
  tipo      String
  url       String
  tamanho   Int?
  createdAt DateTime @default(now())
  peca      Peca     @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@index([pecaId])
}

model CompatibilidadeVeiculo {
  id         String   @id @default(cuid())
  pecaId     String
  marca      String   @default("")
  modelo     String   @default("")
  anoInicial Int?
  anoFinal   Int?
  motor      String?
  versao     String?
  observacao String?
  createdAt  DateTime @default(now())
  peca       Peca     @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@index([pecaId])
  @@index([marca])
  @@index([modelo])
}

model Pedido {
  id                String            @id @default(cuid())
  numero            Int               @unique @default(autoincrement())
  tipo              String            @default("VENDA")
  status            String            @default("ABERTO")
  origem            String?
  ordemServicoId    String?
  clienteId         String?
  clienteNome       String?
  clienteTelefone   String?
  clienteCpf        String?
  retiradaNome      String?
  retiradaTelefone  String?
  retiradaDocumento String?
  retiradaEm        DateTime?
  qrCode            String?
  subtotal          Decimal           @default(0)
  descontoTotal     Decimal           @default(0)
  total             Decimal           @default(0)
  formaPagamento    String?
  criadoPor         String?
  criadoPorId       String?
  canceladoPor      String?
  canceladoEm       DateTime?
  observacoes       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  garantiasCliente  GarantiaCliente[]
  historico         HistoricoPedido[]
  cliente           Cliente?          @relation(fields: [clienteId], references: [id])
  itens             PedidoItem[]
  venda             Venda?

  @@index([numero])
  @@index([tipo])
  @@index([status])
  @@index([createdAt])
  @@index([criadoPor])
  @@index([ordemServicoId])
  @@index([clienteId])
}

model PedidoItem {
  id              String  @id @default(cuid())
  pedidoId        String
  pecaId          String
  quantidade      Int     @default(1)
  precoOriginal   Decimal @default(0)
  descontoPercent Decimal @default(0)
  descontoReais   Decimal @default(0)
  precoVendido    Decimal @default(0)
  subtotal        Decimal @default(0)
  reservado       Boolean @default(false)
  observacao      String?
  peca            Peca    @relation(fields: [pecaId], references: [id])
  pedido          Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([pecaId])
}

model HistoricoPedido {
  id        String   @id @default(cuid())
  pedidoId  String
  tipo      String
  descricao String?
  usuario   String?
  usuarioId String?
  createdAt DateTime @default(now())
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([tipo])
  @@index([createdAt])
}

model Venda {
  id                     String                 @id @default(cuid())
  numero                 Int                    @unique @default(autoincrement())
  pedidoId               String                 @unique
  status                 String                 @default("PAGA")
  origem                 String?
  operadorNome           String?
  operadorId             String?
  clienteNome            String?
  clienteTelefone        String?
  clienteCpf             String?
  subtotal               Decimal                @default(0)
  descontoTotal          Decimal                @default(0)
